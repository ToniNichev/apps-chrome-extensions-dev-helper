{
  "name": "Dev Helper",
  "description": "Modern MV3 rebuild of Dev Helper for profiling, proxy rules, rewrite rules, header overrides, and script injection.",
  "version": "3.1.0",
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "webRequest",
    "proxy",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "app/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Dev Helper",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "app/popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "app/content/injector.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "app/injected/*.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
